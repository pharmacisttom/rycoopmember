# Central PHP backend origin (Rycoopweb)
PHP_BACKEND_URL="https://rayongcoop.tomvisolution.tech"
LEGACY_API_BASE_URL="https://rayongcoop.tomvisolution.tech"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="https://member.rayongcoop.tomvisolution.tech"

# Server-side Session Secret (Must be unique and at least 32 characters in production)
TOMVIS_SESSION_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Readonly Web API Token Hash (Optional)
WEB_READONLY_API_TOKEN_HASH=""

# Node Environment
NODE_ENV="production"

# PHP session cookie configured in rycoopweb/config/security.php
PHP_SESSION_COOKIE_NAME="rayongcoop_session"
# Persistent shared private directory for all Node workers (outside the web root)
SESSION_STATE_DIR="/var/lib/rycoopmember/sessions"
